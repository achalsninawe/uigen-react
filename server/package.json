{
  "name": "@spec2ui/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --import tsx --watch --watch-path=src src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:emit": "tsx scripts/verify-emit.ts",
    "verify:bff": "tsx scripts/verify-bff.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "verify:reconcile": "tsx scripts/verify-reconcile.ts",
    "verify:emit-parses": "tsx scripts/verify-emit-parses.ts",
    "verify:screen-checks": "tsx scripts/verify-screen-checks.ts",
    "diagnose:api": "tsx scripts/diagnose-api.ts",
    "verify:shell": "tsx scripts/verify-shell.ts",
    "verify:probe": "tsx scripts/verify-probe.ts",
    "verify:prompt": "tsx scripts/verify-prompt.ts",
    "verify:ai-generate": "tsx scripts/verify-ai-generate.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@azure/data-tables": "^13.3.1",
    "@azure/storage-blob": "^12.27.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.9.0",
    "multer": "^2.0.0",
    "nanoid": "^5.1.0",
    "openai": "^4.83.0",
    "unpdf": "^0.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
