# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_ENDPOINT=...
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Which of the two deployments above to use: v1 (AZURE_OPENAI_*) or v2
# (AZURE_V2_*). Either deployment name works too, e.g. AZURE_MODEL=gpt-4o.
# Unset, the v2 deployment wins whenever its key and endpoint are both set.
AZURE_MODEL=v1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Azure Storage (blobs + tables) ---
# Leave blank to fall back to the local filesystem under WORK_DIR.
AZURE_STORAGE_CONNECTION_STRING=...
# Prefixes every container and table name, so one account can host several instances.
AZURE_STORAGE_PREFIX=...

# --- Server ---
# Signs session cookies. Optional for a single local instance (a key is kept in
# .work/session.key); required for any deployment or more than one instance.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

PORT=5177
# Local scratch only (materializing a project to run `vite dev`). Source of truth is Azure.
WORK_DIR=./.work
RUNNER_PORT_START=5310
RUNNER_PORT_END=5360

# Re-read a document for screens the first analyze pass dropped. Off by default:
# it is an extra model call, and the first pass is usually right. The mismatch is
# reported either way, so a dropped screen is never silent.
RECOVER_MISSING_SCREENS=0

# Call each safely reachable GET once before planning, and use the shape that
# comes back instead of the one guessed from your documents. Only GET is ever
# called. Set to 0 to turn it off.
PROBE_ENDPOINTS=1
